# Omni UGC Studio configuration. Copy to .env and fill in.
# Every variable is optional unless marked REQUIRED.

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=8080
# all = API + worker in one process, web = API only, worker = job runner only
ROLE=all
LOG_LEVEL=info
# Public URL of the app, used for the Origin check on mutating requests (recommended in production)
# PUBLIC_ORIGIN=https://ugc.example.com

# --- Gemini ----------------------------------------------------------------
# REQUIRED unless GEMINI_MOCK=true. Kept server-side only, never sent to the browser.
GEMINI_API_KEY=
# true = no calls to Google; videos are synthesized locally with ffmpeg (demo / CI)
GEMINI_MOCK=false
OMNI_MODEL=gemini-omni-1.1-flash
SPLITTER_MODEL=gemini-3.8-flash
# Per HTTP request timeout and max wall time for one 10s turn (seconds)
GEMINI_REQUEST_TIMEOUT_SEC=900
GEMINI_TURN_TIMEOUT_SEC=1500
GEMINI_POLL_INTERVAL_SEC=8
# Mock mode only
MOCK_TURN_SECONDS=6
MOCK_EXTENSION_RETURNS_FULL=true

# --- Database (PostgreSQL 14+) --------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/omni_ugc
DATABASE_SSL=false
DATABASE_POOL_MAX=10
MIGRATE_ON_START=true

# --- Storage ---------------------------------------------------------------
# local = filesystem (single host or shared volume), s3 = any S3-compatible bucket
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./data/storage
# S3 / Google Cloud Storage (interoperability HMAC keys) / Cloudflare R2 / MinIO
# S3_BUCKET=omni-ugc-videos
# S3_REGION=auto
# S3_ENDPOINT=https://storage.googleapis.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
# S3_PREFIX=
# S3_PRESIGNED_URLS=true
# S3_PRESIGN_TTL_SEC=3600

# --- Auth & security -------------------------------------------------------
# Password for the web UI. REQUIRED in production (or API_TOKENS, or AUTH_DISABLED=true behind an auth proxy)
APP_PASSWORD=
# REQUIRED in production with APP_PASSWORD: random string, at least 32 characters
# generate with: openssl rand -base64 48
SESSION_SECRET=
SESSION_TTL_HOURS=168
# Comma-separated bearer tokens for programmatic API access
API_TOKENS=
AUTH_DISABLED=false
TRUST_PROXY=true
RATE_LIMIT_PER_MINUTE=120
CREATE_RATE_LIMIT_PER_HOUR=30

# --- Worker & spend control ------------------------------------------------
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_MS=2000
JOB_LEASE_SEC=120
JOB_MAX_ATTEMPTS=3
MAX_QUEUED_JOBS=20
# Hard cap on estimated + actual spend per UTC day, in USD. Empty = no cap.
DAILY_BUDGET_USD=

# --- Pricing (USD). Defaults follow the Gemini API price list for gemini-omni-1.1-flash.
PRICE_VIDEO_OUTPUT_PER_M_TOKENS=17.5
PRICE_INPUT_PER_M_TOKENS=1.5
PRICE_TEXT_OUTPUT_PER_M_TOKENS=9
VIDEO_TOKENS_PER_SEC_360P=1931
VIDEO_TOKENS_PER_SEC_720P=5792
VIDEO_TOKENS_PER_SEC_1080P=8688
VIDEO_TOKENS_PER_SEC_4K=17376
VIDEO_INPUT_TOKENS_PER_SEC=5792
IMAGE_INPUT_TOKENS=1120
# Text + thinking tokens Omni spends per turn (billed at the text output rate)
TURN_TEXT_OUTPUT_TOKENS=1100
SPLITTER_PRICE_PER_CALL_USD=0.002
# new_seconds = extension billed for the new 10s of video (observed), full_output = for the whole 20s clip
EXTENSION_BILLING=new_seconds

# --- Media processing ------------------------------------------------------
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MEDIA_TIMEOUT_SEC=600
